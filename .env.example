# coexistir-door — copy these keys into a local .env (never commit .env)
# All values below are empty placeholders. Fill them locally; nothing here is a real credential.

# Speech in (Deepgram STT / streaming)
DEEPGRAM_API_KEY=

# Speech out (TTS provider used by the voice bridge)
TTS_API_KEY=
TTS_VOICE_ID=

# LiveKit (realtime transport for the room the door talks to)
LIVEKIT_SERVER_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Server
MONGODB_URI=
PORT=4030
CORS_ORIGIN=http://localhost:5556

# Optional: household consult / chat model
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional: Nemotron polish lane for the manager turn (FREE tier, no card).
# 1. Create + verify a free account at https://build.nvidia.com
#    (top-right "Login" -> "Create an Account" joins the Developer Program).
# 2. Open https://build.nvidia.com/settings -> "Generate API Key".
# 3. Paste the key below. Never commit .env — only this example is tracked.
# Without a key the door keeps working: /turn?model=nemotron returns the
# composed briefing unchanged with provider.fallback=true.
NEMOTRON_API_KEY=
# NVIDIA_API_KEY=  (accepted as a fallback alias for NEMOTRON_API_KEY)
NEMOTRON_API_BASE=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
